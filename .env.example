# Copiá este archivo como .env y completá los valores.
# El archivo .env está en .gitignore: nunca se sube al repositorio.

# --- Vercel AI Gateway ---
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh

# --- Modelos por rol (formato "proveedor/modelo", como en el catálogo de Vercel) ---
# Se dejan vacíos A PROPÓSITO: la elección se decide con datos (scripts/smoke_test_models.py).
# SUPERVISOR: el más potente / con mejor razonamiento.
# INVESTIGADOR y ANALISTA: buenos, pero no necesariamente top.
# Candidatos de ejemplo (verificar ID exacto y precio en el catálogo de Vercel):
#   anthropic/claude-sonnet-5.5 · deepseek/deepseek-v4-pro · alibaba/qwen3.7-plus
#   meta/muse-spark-1.3 · reflection/beam · anthropic/claude-haiku-5.5
SUPERVISOR_MODEL=
RESEARCHER_MODEL=
ANALYST_MODEL=

# --- Herramientas ---
TAVILY_API_KEY=

# --- Control del grafo ---
# Tope de pasos del supervisor (evita el "supervisor infinito")
MAX_STEPS=8
